{
  "name": "lumen-archive",
  "private": true,
  "description": "Tailwind CSS build for the Lumen Archive Flask app",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/tailwind.css -o ./public/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/tailwind.css -o ./public/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
