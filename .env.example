# Copy to .env for local development (or run `vercel env pull .env`).

# Flask session signing key. Set a long random value in Vercel → Project → Settings → Environment Variables.
SECRET_KEY=change-me

# Added automatically when you connect a Vercel Blob store to the project.
# Leave empty locally to use file storage in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# "public" or "private": must match the access mode you chose when creating the Blob store.
BLOB_ACCESS=public

# "auto" (Blob when a token is present, else local files), "blob", or "local".
STORAGE_BACKEND=auto

# Optional: require this passcode to publish new entries.
WRITE_PASSCODE=

# Seconds to cache entry listings inside a warm function instance.
CACHE_TTL=30
